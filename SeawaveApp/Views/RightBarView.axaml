<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SeawaveApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="SeawaveApp.Views.RightBarView"
             x:DataType="vm:RightBarViewModel"
             Padding="16">

    <Grid RowDefinitions="Auto, Auto, Auto *">

        <Grid Grid.Row="0"
              ColumnDefinitions="*, Auto"
              Margin="0,0,0,16">
            <TextBlock Grid.Column="0"
                       Text="Play Queue"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrushTextWhite}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Clear All"
                    Command="{Binding ClearAllQueueCommand}"
                    Background="Transparent"
                    Foreground="{StaticResource BrushTextMuted}"
                    FontSize="12"
                    ToolTip.Tip="Flush entire current audio execution queue pipeline" />
        </Grid>

        <StackPanel Grid.Row="1"
                    Spacing="6"
                    Margin="0,0,0,16"
                    IsVisible="{Binding CurrentDisplayTrack,
                    Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="Now Playing"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrushTextWhite}"
                       LetterSpacing="0.05" />

            <Border Background="{StaticResource BrushAbyssalDark}"
                    BorderBrush="{StaticResource BrushElectricBlue}"
                    BorderThickness="1"
                    Padding="8"
                    CornerRadius="4">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Text="{Binding CurrentDisplayTrack.Title,
                            FallbackValue={x:Null}}"
                            Foreground="{StaticResource BrushTextWhite}"
                            FontWeight="Bold"
                            FontSize="14"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{Binding CurrentDisplayTrack.Artist,
                            FallbackValue={x:Null}}"
                            Foreground="{StaticResource BrushTextMuted}"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Panel Grid.Column="1" />
                </Grid>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="Next Up"
                   FontSize="11"
                   FontWeight="Bold"
                   Foreground="{StaticResource BrushTextMuted}"
                   LetterSpacing="0.05"
                   Margin="0,0,0,8"
                   IsVisible="{Binding DisplayQueue.Count,
                   FallbackValue=0}" />

        <ListBox Grid.Row="3"
                 ItemsSource="{Binding DisplayQueue}"
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource BrushAbyssalDark}"
                            Margin="0,0,0,6"
                            Padding="8"
                            CornerRadius="4"
                            DoubleTapped="Border_OnDoubleTapped">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0"
                                        Spacing="2">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{StaticResource BrushTextWhite}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="✕"
                                    Command="{Binding $parent[UserControl].((vm:RightBarViewModel)DataContext).RemoveTrackFromQueueCommand,
                                    FallbackValue={x:Null}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Remove item from queue loop" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>