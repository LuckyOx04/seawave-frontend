<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignWidth="800" 
             d:DesignHeight="450"
             x:Class="SeawaveApp.Views.ChangePasswordView"
             Padding="40">
    
    <Grid Background="{StaticResource BrushAbyssalDark}">
        <Border Background="{StaticResource BrushSurfaceSlate}" 
                Width="460" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Padding="32" 
                CornerRadius="12">
            
            <StackPanel Spacing="20">
                
                <StackPanel Spacing="4">
                    <TextBlock Text="Update Security Parameters" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="Establish a new master synchronization password entry" 
                               FontSize="12" 
                               Foreground="{StaticResource BrushTextMuted}"/>
                </StackPanel>

                <Separator Background="{StaticResource BrushSurfaceHover}" 
                           Height="1"/>

                <StackPanel Spacing="6">
                    <TextBlock Text="Current Password Entry" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBox Watermark="Verify existing secret key..." 
                             PasswordChar="●" 
                             Height="40" 
                             CornerRadius="6" 
                             Background="{StaticResource BrushAbyssalDark}" 
                             Foreground="White" 
                             BorderThickness="1" 
                             BorderBrush="{StaticResource BrushSurfaceHover}" 
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="New Requested Password" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBox Watermark="Minimum 8 characters..." 
                             PasswordChar="●" 
                             Height="40" 
                             CornerRadius="6" 
                             Background="{StaticResource BrushAbyssalDark}" 
                             Foreground="White" 
                             BorderThickness="1" 
                             BorderBrush="{StaticResource BrushSurfaceHover}" 
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Repeat New Password" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBox Watermark="Re-enter verification layout..." 
                             PasswordChar="●" 
                             Height="40" 
                             CornerRadius="6" 
                             Background="{StaticResource BrushAbyssalDark}" 
                             Foreground="White" 
                             BorderThickness="1" 
                             BorderBrush="{StaticResource BrushSurfaceHover}" 
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <Grid ColumnDefinitions="*, 12, *" 
                      Margin="0,10,0,0">
                    <Button Grid.Column="0" 
                            Content="Cancel Override" 
                            Background="Transparent" 
                            Foreground="{StaticResource BrushTextMuted}" 
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center" 
                            Height="40" 
                            VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" 
                            Content="Commit Key Update" 
                            Background="{StaticResource BrushElectricBlue}" 
                            Foreground="White" 
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center" 
                            Height="40" 
                            VerticalContentAlignment="Center" 
                            FontWeight="Bold" 
                            CornerRadius="6"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
