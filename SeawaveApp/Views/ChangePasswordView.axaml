<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SeawaveApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="520"
             x:Class="SeawaveApp.Views.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel"
             Padding="40"
             Background="{StaticResource BrushAbyssalDark}">

    <Grid Background="{StaticResource BrushAbyssalDark}">
        <Border Background="{StaticResource BrushSurfaceSlate}"
                Width="460"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="32"
                CornerRadius="12">

            <StackPanel Spacing="20">

                <StackPanel Spacing="4">
                    <TextBlock Text="Change password"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White" />
                </StackPanel>

                <Separator Background="{StaticResource BrushSurfaceHover}"
                           Height="1" />

                <StackPanel Spacing="6">
                    <TextBlock Text="Current Password"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <TextBox Watermark="Enter current password..."
                             Text="{Binding CurrentPassword, Mode=TwoWay}"
                             PasswordChar="●"
                             Height="40"
                             CornerRadius="6"
                             Background="{StaticResource BrushAbyssalDark}"
                             Foreground="White"
                             BorderThickness="1"
                             BorderBrush="{StaticResource BrushSurfaceHover}"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="New Password"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <TextBox Watermark="Enter new password..."
                             Text="{Binding NewPassword, Mode=TwoWay}"
                             PasswordChar="●"
                             Height="40"
                             CornerRadius="6"
                             Background="{StaticResource BrushAbyssalDark}"
                             Foreground="White"
                             BorderThickness="1"
                             BorderBrush="{StaticResource BrushSurfaceHover}"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Confirm New Password"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <TextBox Watermark="Re-enter the new password..."
                             Text="{Binding ConfirmPassword, Mode=TwoWay}"
                             PasswordChar="●"
                             Height="40"
                             CornerRadius="6"
                             Background="{StaticResource BrushAbyssalDark}"
                             Foreground="White"
                             BorderThickness="1"
                             BorderBrush="{StaticResource BrushSurfaceHover}"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusColor}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage,
                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <Grid ColumnDefinitions="*, 12, *"
                      Margin="0,10,0,0">
                    <Button Grid.Column="0"
                            Command="{Binding CancelCommand}"
                            Content="Cancel"
                            Background="Transparent"
                            Foreground="{StaticResource BrushTextMuted}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Height="40"
                            VerticalContentAlignment="Center" />
                    <Button Grid.Column="2"
                            Command="{Binding ExecuteChangePasswordCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            Content="Change"
                            Background="{StaticResource BrushElectricBlue}"
                            Foreground="White"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Height="40"
                            VerticalContentAlignment="Center"
                            FontWeight="Bold"
                            CornerRadius="6" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>