<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SeawaveApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SeawaveApp.Views.LeftBarView"
             x:DataType="vm:LeftBarViewModel">

    <Grid RowDefinitions="Auto, Auto, *"
          Padding="12">
        <StackPanel Grid.Row="0"
                    Spacing="4"
                    Margin="0,0,0,16">
            <RadioButton Classes="MenuButton"
                         IsChecked="True"
                         Command="{Binding ShowHomeCommand}"
                         Height="40"
                         Background="Transparent"
                         ToolTip.Tip="Navigate back to your home discovery shelf">
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            Padding="8,0">
                    <TextBlock Text="🏠"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Ocean Floor"
                               Foreground="{StaticResource BrushTextWhite}"
                               FontWeight="Medium" />
                </StackPanel>
            </RadioButton>

            <RadioButton Classes="MenuButton"
                         Command="{Binding ShowLibraryCommand}"
                         Height="40"
                         Background="Transparent"
                         ToolTip.Tip="Explore your locally stored deep audio archive">
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            Padding="8,0">
                    <TextBlock Text="🎵"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Your Currents"
                               Foreground="{StaticResource BrushTextWhite}"
                               FontWeight="Medium" />
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="*, Auto"
              Margin="8,0,8,8">
            <TextBlock Grid.Column="0"
                       Text="PLAYLISTS"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrushTextMuted}"
                       VerticalAlignment="Center"
                       LetterSpacing="1" />
            <Button Grid.Column="1"
                    Background="Transparent"
                    Padding="4"
                    CornerRadius="4"
                    Command="{Binding CreatePlaylistCommand}"
                    ToolTip.Tip="Forge a new custom audio playlist container">
                <TextBlock Text="＋"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="14"
                           FontWeight="Bold" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CustomPlaylists}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Background="Transparent"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="8"
                                CornerRadius="4"
                                Command="{Binding $parent[UserControl].((vm:LeftBarViewModel)DataContext).OpenPlaylistCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Stream this collection">
                            <TextBlock Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource BrushTextMuted}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>