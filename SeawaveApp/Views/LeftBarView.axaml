<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SeawaveApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="SeawaveApp.Views.LeftBarView"
             x:DataType="vm:LeftBarViewModel"
             Padding="12">

    <Grid RowDefinitions="Auto, Auto, *">
        <StackPanel Grid.Row="0"
                    Spacing="8"
                    Margin="0,0,0,16">
            <TextBox Watermark="Filter playlists..."
                     Text="{Binding PlaylistSearchQuery, Mode=TwoWay}"
                     Background="{StaticResource BrushAbyssalDark}"
                     Foreground="{StaticResource BrushTextWhite}"
                     CornerRadius="4"
                     ToolTip.Tip="Type here to dynamically filter your current collections list" />

            <CheckBox Content="Online Only"
                      IsChecked="{Binding ShowOnlineOnly, Mode=TwoWay}"
                      Foreground="{StaticResource BrushTextMuted}"
                      ToolTip.Tip="Isolate cloud-hosted streaming configurations" />
            <CheckBox Content="Offline Only"
                      IsChecked="{Binding ShowOfflineOnly, Mode=TwoWay}"
                      Foreground="{StaticResource BrushTextMuted}"
                      ToolTip.Tip="Isolate native local storage items" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="PLAYLISTS"
                   FontSize="11"
                   FontWeight="Bold"
                   Foreground="{StaticResource BrushTextMuted}"
                   Margin="4,0,0,8"
                   LetterSpacing="1" />

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding FilteredPlaylists}"
                 SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"
                               Foreground="{StaticResource BrushTextWhite}"
                               Padding="4,6"
                               TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>