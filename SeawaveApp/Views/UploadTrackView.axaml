<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SeawaveApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="600"
             x:Class="SeawaveApp.Views.UploadTrackView"
             x:DataType="vm:UploadTrackViewModel"
             Padding="40"
             Background="{StaticResource BrushAbyssalDark}">

    <Grid Background="{StaticResource BrushAbyssalDark}">
        <Border Background="{StaticResource BrushSurfaceSlate}"
                Width="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="32"
                CornerRadius="12">
            <StackPanel Spacing="22">
                <StackPanel Spacing="4">
                    <TextBlock Text="Upload Track"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="Specify an audio file along with title and artist to upload."
                               FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}" />
                </StackPanel>

                <Separator Background="{StaticResource BrushSurfaceHover}"
                           Height="1" />

                <StackPanel Spacing="6">
                    <TextBlock Text="Audio File Selection"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <Grid ColumnDefinitions="*, 12, Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding FilePath}"
                                 IsEnabled="False"
                                 PlaceholderText="No local file selected for upload..."
                                 IsReadOnly="True"
                                 Height="40"
                                 CornerRadius="6"
                                 Background="{StaticResource BrushAbyssalDark}"
                                 Foreground="White"
                                 VerticalContentAlignment="Center" />
                        <Button Grid.Column="2"
                                Command="{Binding ExecuteBrowseCommand}"
                                Content="Browse Local Storage"
                                Background="{StaticResource BrushSurfaceHover}"
                                Foreground="White"
                                Height="40"
                                Padding="16,0"
                                VerticalContentAlignment="Center"
                                CornerRadius="6" />
                    </Grid>
                </StackPanel>

                <Grid ColumnDefinitions="*, 16, *">
                    <StackPanel Grid.Column="0"
                                Spacing="6">
                        <TextBlock Text="Track Title"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextMuted}" />
                        <TextBox PlaceholderText="Enter track title..."
                                 Text="{Binding Title, Mode=TwoWay}"
                                 Height="40"
                                 CornerRadius="6"
                                 Background="{StaticResource BrushAbyssalDark}"
                                 Foreground="White"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Spacing="6">
                        <TextBlock Text="Track Artist"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextMuted}" />
                        <TextBox PlaceholderText="Enter track artist..."
                                 Text="{Binding Artist, Mode=TwoWay}"
                                 Height="40"
                                 CornerRadius="6"
                                 Background="{StaticResource BrushAbyssalDark}"
                                 Foreground="White"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding StatusColor}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, 
                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <Separator Background="{StaticResource BrushSurfaceHover}"
                           Height="1"
                           Margin="0,4,0,0" />

                <Grid ColumnDefinitions="*, *">
                    <Button Grid.Column="0"
                            Command="{Binding CancelCommand}"
                            Content="Cancel"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            Foreground="{StaticResource BrushTextMuted}"
                            Height="42"
                            VerticalContentAlignment="Center" />
                    <Button Grid.Column="1"
                            Command="{Binding ExecuteUploadCommand}"
                            Content="Upload"
                            HorizontalAlignment="Center"
                            Background="{StaticResource BrushElectricBlue}"
                            Foreground="White"
                            Height="42"
                            Padding="24,0"
                            VerticalContentAlignment="Center"
                            FontWeight="Bold"
                            CornerRadius="6" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>