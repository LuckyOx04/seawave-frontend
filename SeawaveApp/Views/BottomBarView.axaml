<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SeawaveApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1080"
             d:DesignHeight="150"
             x:Class="SeawaveApp.Views.BottomBarView"
             x:DataType="vm:BottomBarViewModel">

    <Border Background="{StaticResource BrushSurfaceSlate}"
            Height="90"
            Padding="16,0">
        <Grid ColumnDefinitions="250, *, 250"
              VerticalAlignment="Center">

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="2">
                <TextBlock
                    Text="{Binding CurrentTrack.Title, 
                    FallbackValue='No Track Selected'}"
                    IsVisible="{Binding CurrentTrack, 
                    Converter={x:Static ObjectConverters.IsNotNull}}"
                    Foreground="{StaticResource BrushTextWhite}"
                    FontWeight="SemiBold"
                    FontSize="14"
                    TextTrimming="WordEllipsis" />
                <TextBlock
                    Text="{Binding CurrentTrack.Artist, 
                    FallbackValue='No Album'}"
                    IsVisible="{Binding CurrentTrack, 
                    Converter={x:Static ObjectConverters.IsNotNull}}"
                    Foreground="{StaticResource BrushTextMuted}"
                    FontSize="12"
                    TextTrimming="WordEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Spacing="16">
                    <ToggleButton Content="⤮"
                                  IsChecked="{Binding IsShuffleOn}"
                                  Command="{Binding ToggleShuffleCommand}"
                                  Background="Transparent"
                                  ToolTip.Tip="Toggle shuffle" />

                    <Button Content="⏮"
                            Command="{Binding SkipPreviousCommand}"
                            Background="Transparent" />

                    <Button Command="{Binding TogglePlayPauseCommand}"
                            Background="{StaticResource BrushElectricBlue}"
                            Width="36"
                            Height="36"
                            CornerRadius="18">
                        <Panel HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                            <TextBlock Text="⏸"
                                       IsVisible="{Binding IsPlaying}"
                                       Foreground="White" />
                            <TextBlock Text="▶"
                                       IsVisible="{Binding !IsPlaying}"
                                       Foreground="White"
                                       Margin="2,0,0,0" />
                        </Panel>
                    </Button>

                    <Button Content="⏭"
                            Command="{Binding SkipNextCommand}"
                            Background="Transparent" />

                    <Button Content="{Binding RepeatModeLabel}"
                            Command="{Binding CycleRepeatCommand}"
                            Background="{StaticResource BrushAbyssalDark}"
                            Foreground="{StaticResource BrushTextWhite}"
                            FontSize="11"
                            Padding="8,4"
                            CornerRadius="4"
                            ToolTip.Tip="Switch repeat modes" />
                </StackPanel>

                <Grid ColumnDefinitions="Auto, *, Auto" Height="27">
                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentPosition, 
                               StringFormat=\{0:mm\\:ss\}}"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center" />

                    <Slider Grid.Column="1"
                            Margin="8,0"
                            Minimum="0"
                            Maximum="{Binding TrackDurationSeconds}"
                            Value="{Binding CurrentPositionSeconds}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            SmallChange="1"
                            Foreground="{StaticResource BrushElectricBlue}"
                            Height="40"
                            VerticalAlignment="Bottom">
                        
                            <Interaction.Behaviors>
                                <EventTriggerBehavior EventName="DragCompleted"
                                                      SourceObject="{Binding $self}">
                                    <InvokeCommandAction Command="{Binding SeekToTimeCommand}"
                                                         CommandParameter="{Binding $parent[Slider].Value}" />
                                </EventTriggerBehavior>
                            </Interaction.Behaviors>
                    </Slider>

                    <TextBlock Grid.Column="2"
                               Text="{Binding TrackDuration, 
                               StringFormat=\{0:mm\\:ss\}}"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <Panel Grid.Column="2" />
        </Grid>
    </Border>
</UserControl>