<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SeawaveApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1920"
             d:DesignHeight="1080"
             x:Class="SeawaveApp.Views.ProfileView"
             x:DataType="vm:ProfileViewModel"
             Padding="40"
             Background="{StaticResource BrushAbyssalDark}">

    <Grid Background="{StaticResource BrushAbyssalDark}"
          RowDefinitions="Auto,*">

        <DockPanel Grid.Row="0"
                   Margin="0,0,0,32">

            <Button Command="{Binding ReturnToMainWindowCommand}"
                    Background="{StaticResource BrushSurfaceSlate}"
                    Foreground="{StaticResource BrushTextWhite}"
                    Padding="14,8"
                    CornerRadius="6"
                    FontWeight="SemiBold">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">

                    <PathIcon Data="{StaticResource IconLeftArrow}"
                              Width="14"
                              Height="14" />

                    <TextBlock Text="Return to Music Player" />

                </StackPanel>
            </Button>
            <TextBlock Text="USER PROFILE"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource BrushTextMuted}"
                       FontSize="12"
                       FontWeight="Bold"
                       LetterSpacing="1" />
        </DockPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="300, 40, *">

            <Border Grid.Column="0"
                    Background="{StaticResource BrushSurfaceSlate}"
                    Padding="24"
                    CornerRadius="12"
                    VerticalAlignment="Top">

                <StackPanel Spacing="20"
                            HorizontalAlignment="Center">

                    <Border Width="96"
                            Height="96"
                            CornerRadius="48"
                            Background="{StaticResource BrushAbyssalDark}"
                            HorizontalAlignment="Center">

                        <PathIcon Data="{StaticResource IconUser}"
                                  Width="48"
                                  Height="48"
                                  Foreground="{StaticResource BrushElectricBlue}" />
                    </Border>

                    <StackPanel Spacing="4"
                                HorizontalAlignment="Center">
                        <TextBlock Text="{Binding UsernameText}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextWhite}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmailText}"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushElectricBlue}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <Separator Background="{StaticResource BrushSurfaceHover}"
                               Height="1" />

                    <StackPanel Spacing="10">

                        <Button Command="{Binding NavigateToUploadTrackCommand}"
                                Background="{StaticResource BrushElectricBlue}"
                                Foreground="{StaticResource BrushTextWhite}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,12"
                                CornerRadius="6"
                                FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="5">

                                <PathIcon Data="{StaticResource IconUpArrow}"
                                          Width="14"
                                          Height="14" />

                                <TextBlock Text="Upload Track" />

                            </StackPanel>
                        </Button>

                        <Button Content="Change Password"
                                Command="{Binding NavigateToChangePasswordCommand}"
                                Background="{StaticResource BrushSurfaceHover}"
                                Foreground="{StaticResource BrushTextWhite}"
                                Width="202"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,10"
                                CornerRadius="6" />

                        <Button Content="Logout"
                                Command="{Binding ExecuteLogoutCommand}"
                                Background="{StaticResource BrushTransparentRed}"
                                Foreground="{StaticResource BrushLightRed}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,10"
                                CornerRadius="6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource BrushSurfaceSlate}"
                    Padding="32"
                    CornerRadius="12">

                <StackPanel Spacing="24">
                    <TextBlock Text="Account Overview"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextWhite}" />

                    <Grid ColumnDefinitions="*, 16, *, 16, *"
                          RowDefinitions="*, 16, *">
                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Background="{StaticResource BrushAbyssalDark}"
                                Padding="20"
                                CornerRadius="8">

                            <StackPanel Spacing="6">
                                <TextBlock Text="Created Online Playlists"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           FontWeight="Bold" />
                                <TextBlock Text="{Binding CreatedPlaylistsCount}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextWhite}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0"
                                Grid.Column="2"
                                Background="{StaticResource BrushAbyssalDark}"
                                Padding="20"
                                CornerRadius="8">

                            <StackPanel Spacing="6">
                                <TextBlock Text="Uploaded Tracks Pending"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           FontWeight="Bold" />
                                <TextBlock Text="{Binding PendingTracksCount}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextWhite}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="0"
                                Grid.Column="4"
                                Background="{StaticResource BrushAbyssalDark}"
                                Padding="20"
                                CornerRadius="8">

                            <StackPanel Spacing="6">
                                <TextBlock Text="Uploaded Tracks Approved"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           FontWeight="Bold" />
                                <TextBlock Text="{Binding ApprovedTracksCount}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextWhite}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2"
                                Grid.Column="0"
                                Background="{StaticResource BrushAbyssalDark}"
                                Padding="20"
                                CornerRadius="8">

                            <StackPanel Spacing="6">
                                <TextBlock Text="Date Registered"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           FontWeight="Bold" />
                                <TextBlock
                                    Text="{Binding CreatedAt}"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource BrushTextWhite}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>