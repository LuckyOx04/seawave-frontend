<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SeawaveApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="SeawaveApp.Views.RegisterView"
             x:DataType="vm:RegisterViewModel">

    <Grid Background="{StaticResource BrushAbyssalDark}">
        <Border Background="{StaticResource BrushSurfaceSlate}"
                Width="420"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="32"
                CornerRadius="12"
                BoxShadow="0 8 24 0 #2A000000">
            <StackPanel Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock Text="Create Account"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="Join the cloud stream synchronization platform"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Username"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <TextBox Watermark="Enter username..."
                             Text="{Binding Username, Mode=TwoWay}"
                             Height="40"
                             CornerRadius="6"
                             Background="{StaticResource BrushAbyssalDark}"
                             Foreground="White"
                             BorderThickness="1"
                             BorderBrush="{StaticResource BrushSurfaceHover}"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Email Address"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <TextBox Watermark="name@example.com"
                             Text="{Binding Email, Mode=TwoWay}"
                             Height="40"
                             CornerRadius="6"
                             Background="{StaticResource BrushAbyssalDark}"
                             Foreground="White"
                             BorderThickness="1"
                             BorderBrush="{StaticResource BrushSurfaceHover}"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <Grid ColumnDefinitions="*, 12, *">
                    <StackPanel Grid.Column="0"
                                Spacing="6">
                        <TextBlock Text="Password"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextMuted}" />
                        <TextBox Watermark="Enter password..."
                                 Text="{Binding Password, Mode=TwoWay}"
                                 PasswordChar="●"
                                 Height="40"
                                 CornerRadius="6"
                                 Background="{StaticResource BrushAbyssalDark}"
                                 Foreground="White"
                                 BorderThickness="1"
                                 BorderBrush="{StaticResource BrushSurfaceHover}"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Spacing="6">
                        <TextBlock Text="Confirm"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextMuted}" />
                        <TextBox Watermark="Repeat password..."
                                 Text="{Binding ConfirmPassword}"
                                 PasswordChar="●"
                                 Height="40"
                                 CornerRadius="6"
                                 Background="{StaticResource BrushAbyssalDark}"
                                 Foreground="White"
                                 BorderThickness="1"
                                 BorderBrush="{StaticResource BrushSurfaceHover}"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
                
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding IsSuccessState, 
                           Converter={StaticResource BooleanToBrushConverter}}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, 
                           Converter={x:Static StringConverters.IsNullOrEmpty}}"/>

                <Button Content="Register Account"
                        Command="{Binding ExecuteRegisterCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Background="{StaticResource BrushElectricBlue}"
                        Foreground="White"
                        Height="42"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontWeight="Bold"
                        CornerRadius="6"
                        Margin="0,10,0,0" />

                <Button Content="← Already have an account? Log In"
                        Command="{Binding NavigateToLoginCommand}"
                        Background="Transparent"
                        Foreground="{StaticResource BrushTextMuted}"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>