<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SeawaveApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1920"
             d:DesignHeight="100"
             x:Class="SeawaveApp.Views.TopBarView"
             x:DataType="vm:TopBarViewModel"
             Padding="16,12">

    <Grid ColumnDefinitions="Auto,*, Auto">

        <Button Grid.Column="0"
                Command="{Binding AddFileCommand}"
                Classes="Modern"
                Height="36"
                ToolTip.Tip="Add local audio tracks or folders.">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <PathIcon Data="{StaticResource IconPlus}"
                          Width="16"
                          Height="16" />
                <TextBlock Text="Add Local Tracks"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="12"
                    HorizontalAlignment="Center">
            <TextBox Width="350"
                     Height="36"
                     IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsOnline,
                     FallbackValue={x:False}}"
                     PlaceholderText="Search tracks..."
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     CornerRadius="18" BorderThickness="1"
                     BorderBrush="{StaticResource BrushSurfaceHover}"
                     Background="{StaticResource BrushAbyssalDark}"
                     Foreground="{StaticResource BrushTextWhite}"
                     VerticalContentAlignment="Center"
                     ToolTip.Tip="Type to search." />

            <Button Content="Search"
                    IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsOnline,
                     FallbackValue={x:False}}"
                    Command="{Binding ExecuteSearchCommand}"
                    Classes="Modern"
                    Height="36"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="Search for results." />
        </StackPanel>

        <Button Grid.Column="2"
                Background="Transparent"
                BorderThickness="0"
                Height="30"
                Margin="12,0"
                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenLoginOrProfileCommand,
                FallbackValue={x:Null}}"
                IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsOnline,
                FallbackValue={x:Null}}">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">

                <PathIcon Data="{StaticResource IconUser}"
                          Foreground="{StaticResource BrushElectricBlue}" />

                <TextBlock Text="Log In"
                           IsVisible="{Binding !$parent[Window].((vm:MainViewModel)DataContext).IsLoggedIn,
                           FallbackValue={x:True}}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <TextBlock
                    Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).Username,
                    FallbackValue={x:Null}}"
                    IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsLoggedIn,
                    FallbackValue={x:False}}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />

            </StackPanel>
        </Button>

    </Grid>
</UserControl>