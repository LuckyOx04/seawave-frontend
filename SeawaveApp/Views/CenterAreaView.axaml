<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SeawaveApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SeawaveApp.Views.CenterAreaView"
             x:DataType="vm:CenterAreaViewModel">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="28">
            <StackPanel Spacing="4">
                <TextBlock Text="Welcome Back to the Depths"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrushTextWhite}" />
                <TextBlock Text="Dive into your recently discovered sonar audio signals below."
                           FontSize="13"
                           Foreground="{StaticResource BrushTextMuted}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding ShowcaseCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   ItemWidth="180"
                                   ItemHeight="240" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BrushAbyssalDark}"
                                Margin="0,0,16,16"
                                Padding="12"
                                CornerRadius="8"
                                ToolTip.Tip="Click to view details or play this wave item">
                            <Grid RowDefinitions="*, Auto, Auto"
                                  HorizontalAlignment="Stretch">
                                <Border Grid.Row="0"
                                        Background="{StaticResource BrushSurfaceSlate}"
                                        CornerRadius="6"
                                        Margin="0,0,0,12">
                                    <Panel>
                                        <TextBlock Text="🌊"
                                                   FontSize="36"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Button Width="40"
                                                Height="40"
                                                CornerRadius="20"
                                                Background="{StaticResource BrushElectricBlue}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="8"
                                                Command="{Binding $parent[UserControl].((vm:CenterAreaViewModel)DataContext).QuickPlayCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Instant Stream Play">
                                            <TextBlock Text="▶"
                                                       Foreground="White"
                                                       Margin="2,0,0,0"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                    </Panel>
                                </Border>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding Title}"
                                           Foreground="{StaticResource BrushTextWhite}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="2"
                                           Text="{Binding MetadataSubtext}"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           FontSize="12"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>