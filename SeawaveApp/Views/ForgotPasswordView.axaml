<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SeawaveApp.Views.ForgotPasswordView">

    <Grid Background="{StaticResource BrushAbyssalDark}">
        <Border Background="{StaticResource BrushSurfaceSlate}"
                Width="400"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="32"
                CornerRadius="12"
                BoxShadow="0 8 24 0 #2A000000">
            <StackPanel Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="Recover Password"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="We'll email you instructions to reset your access code"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Registered Email Address"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <TextBox Watermark="Enter your account email..."
                             Height="40"
                             CornerRadius="6"
                             Background="{StaticResource BrushAbyssalDark}"
                             Foreground="White"
                             BorderThickness="1"
                             BorderBrush="{StaticResource BrushSurfaceHover}"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <Button Content="Send Reset Verification Token"
                        Background="{StaticResource BrushElectricBlue}"
                        Foreground="White" Height="42"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontWeight="Bold"
                        CornerRadius="6"
                        Margin="0,10,0,0" />

                <Button Content="← Return to Identity Portal"
                        Background="Transparent"
                        Foreground="{StaticResource BrushTextMuted}"
                        FontSize="12"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>