<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SeawaveApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="SeawaveApp.Views.ForgotPasswordView"
             x:DataType="vm:ForgotPasswordViewModel">

    <Grid Background="{StaticResource BrushAbyssalDark}">
        <Border Background="{StaticResource BrushSurfaceSlate}"
                Width="400"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="32"
                CornerRadius="12"
                BoxShadow="0 8 24 0 #2A000000">
            <StackPanel Spacing="20">
                <StackPanel Spacing="4">
                    <TextBlock Text="Reset Password"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="We'll email you instructions to reset your password"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Registered Email Address"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <TextBox PlaceholderText="Enter your account email..."
                             Text="{Binding Email, Mode=TwoWay}"
                             Height="40"
                             CornerRadius="6"
                             Background="{StaticResource BrushAbyssalDark}"
                             Foreground="White"
                             BorderThickness="1"
                             BorderBrush="{StaticResource BrushSurfaceHover}"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="White"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage,
                           Converter={x:Static StringConverters.IsNullOrEmpty}}" />

                <Button Content="Send Reset Email"
                        Command="{Binding ExecuteResetPasswordCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Background="{StaticResource BrushElectricBlue}"
                        Foreground="White" Height="42"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontWeight="Bold"
                        CornerRadius="6"
                        Margin="0,10,0,0" />

                <Button Content="← Return to Login"
                        Command="{Binding NavigateToLoginCommand}"
                        Background="Transparent"
                        Foreground="{StaticResource BrushTextMuted}"
                        FontSize="12"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>