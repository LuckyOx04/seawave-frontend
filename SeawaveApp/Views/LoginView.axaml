<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SeawaveApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="600"
             d:DesignHeight="550"
             x:Class="SeawaveApp.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Panel Background="{StaticResource BrushAbyssalDark}">
        <Border Background="{StaticResource BrushSurfaceSlate}"
                Width="400"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="32"
                CornerRadius="12"
                BoxShadow="0 8 24 0 #2A000000">
            <StackPanel Spacing="20">
                <StackPanel HorizontalAlignment="Center"
                            Margin="0,0,0,10"
                            Spacing="6">
                    <Image Source="{StaticResource SeawaveLogo}"
                           Width="100"
                           Height="100"
                           HorizontalAlignment="Center" />
                    <TextBlock Text="SEAWAVE PLAYER"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushTextWhite}"
                               LetterSpacing="2" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Username or Email"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <TextBox PlaceholderText="Enter username..."
                             Text="{Binding Identifier, Mode=TwoWay}"
                             Height="40"
                             CornerRadius="6"
                             Background="{StaticResource BrushAbyssalDark}"
                             Foreground="{StaticResource BrushTextWhite}"
                             BorderThickness="1"
                             BorderBrush="{StaticResource BrushSurfaceHover}"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Password"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <TextBox PlaceholderText="Enter password..."
                             Text="{Binding Password, Mode=TwoWay}"
                             PasswordChar="●"
                             Height="40"
                             CornerRadius="6"
                             Background="{StaticResource BrushAbyssalDark}"
                             Foreground="{StaticResource BrushTextWhite}"
                             BorderThickness="1"
                             BorderBrush="{StaticResource BrushSurfaceHover}"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource BrushLightRed}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, 
                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <Button Content="Sign In"
                        Command="{Binding ExecuteLoginCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Background="{StaticResource BrushElectricBlue}"
                        Foreground="{StaticResource BrushTextWhite}"
                        Height="42"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontWeight="Bold"
                        CornerRadius="6"
                        Margin="0,10,0,0" />

                <Button Content="Create Account"
                        HorizontalAlignment="Center"
                        Command="{Binding NavigateToRegisterCommand}"
                        Background="Transparent"
                        Foreground="{StaticResource BrushElectricBlue}"
                        FontSize="12"
                        Padding="0" />

                <DockPanel LastChildFill="False"
                           Margin="0,4,0,0">
                    <Button Content="Go Back"
                            Command="{Binding NavigateBackCommand}"
                            Background="Transparent"
                            Foreground="{StaticResource BrushTextMuted}"
                            FontSize="12"
                            Padding="0"
                            DockPanel.Dock="Left" />
                    <Button Content="Forgot Password?"
                            Command="{Binding NavigateToForgotPasswordCommand}"
                            Background="Transparent"
                            Foreground="{StaticResource BrushTextMuted}"
                            FontSize="12"
                            Padding="0"
                            DockPanel.Dock="Right" />

                </DockPanel>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>