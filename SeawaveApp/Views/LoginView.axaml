<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignWidth="800" 
             d:DesignHeight="450"
             x:Class="SeawaveApp.Views.LoginView">
    
    <Grid Background="{StaticResource BrushAbyssalDark}">
        <Border Background="{StaticResource BrushSurfaceSlate}" 
                Width="400" 
                VerticalAlignment="Center"
                HorizontalAlignment="Center" 
                Padding="32" 
                CornerRadius="12" 
                BoxShadow="0 8 24 0 #2A000000">
            <StackPanel Spacing="20">
                <StackPanel HorizontalAlignment="Center" 
                            Margin="0,0,0,10" 
                            Spacing="6">
                    <TextBlock Text="🌊" 
                               FontSize="44" 
                               HorizontalAlignment="Center" />
                    <TextBlock Text="SEAWAVE PLAYER" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="White"
                               LetterSpacing="2" />
                    <TextBlock Text="Sign in to sync your music stream" 
                               FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}" 
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Username or Email" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <TextBox Watermark="Enter username..." 
                             Height="40" 
                             CornerRadius="6"
                             Background="{StaticResource BrushAbyssalDark}" 
                             Foreground="White" 
                             BorderThickness="1"
                             BorderBrush="{StaticResource BrushSurfaceHover}" 
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Password" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <TextBox Watermark="Enter password..." 
                             PasswordChar="●" 
                             Height="40" 
                             CornerRadius="6"
                             Background="{StaticResource BrushAbyssalDark}" 
                             Foreground="White" 
                             BorderThickness="1"
                             BorderBrush="{StaticResource BrushSurfaceHover}" 
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <Button Content="Sign In" 
                        Background="{StaticResource BrushElectricBlue}" 
                        Foreground="White"
                        Height="42" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" 
                        FontWeight="Bold" 
                        CornerRadius="6" 
                        Margin="0,10,0,0" />

                <DockPanel LastChildFill="False" 
                           Margin="0,4,0,0">
                    <Button Content="Forgot Password?" 
                            Background="Transparent"
                            Foreground="{StaticResource BrushTextMuted}" 
                            FontSize="12" 
                            Padding="0" />
                    <Button Content="Create Account" 
                            Background="Transparent"
                            Foreground="{StaticResource BrushElectricBlue}" 
                            FontSize="12" 
                            Padding="0"
                            DockPanel.Dock="Right" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>